# ==========================================================
# Docker Compose stack variables
#
#   cd deploy/compose
#   cp .env.example .env       # then fill in the REQUIRED values below
#   docker compose up --build
#
# These are consumed by docker-compose.yml and, for the marked ones, by the
# docker-compose.prod.yml hardening overlay. They are NOT the application
# config: the backend's own settings live in backend/.env.example and are
# injected into the container by the compose `x-backend-env` anchor.
#
# `.env` must never be committed.
# ==========================================================

# ---------- REQUIRED (compose refuses to start without these) ----------
# At least 32 characters. Generate one:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECURITY__JWT_SECRET=

# At least 12 characters, and not a word from the insecure-default blocklist.
# This only creates the first administrator on an empty database; change it in
# the UI immediately after the first login.
SECURITY__BOOTSTRAP_ADMIN_PASSWORD=

# ---------- Required only by docker-compose.prod.yml ----------
# Pinned release of both images. Never use `latest` in production.
#IMAGE_TAG=v1.0.0
#REGISTRY=registry.example.com/adoptimizer
#REDIS_PASSWORD=
# Explicit https origins, no wildcards. Production boot fails otherwise.
#APP__CORS_ALLOW_ORIGINS=["https://ads.example.com"]
#APP__TRUSTED_HOSTS=["ads.example.com"]
#API_REPLICAS=2
#FRONTEND_REPLICAS=2
#POSTGRES_VERSION=16.6
#REDIS_VERSION=7.4

# ---------- Application ----------
APP__NAME=Ad Optimizer
# development | staging | production. The prod overlay forces production, which
# makes the backend refuse to boot with weak secrets, wildcard CORS or SQLite.
APP__ENVIRONMENT=development
# Comma-free JSON array. The frontend is served from FRONTEND_PORT.
APP__CORS_ALLOW_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# ---------- Ports published on the host ----------
API_PORT=8000
FRONTEND_PORT=8080

# ---------- PostgreSQL ----------
POSTGRES_USER=adoptimizer
# Local only. The prod overlay does not publish the datastore port at all.
POSTGRES_PASSWORD=adoptimizer
POSTGRES_DB=adoptimizer

# ---------- Connection pool ----------
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20

# ---------- Security policy ----------
SECURITY__BOOTSTRAP_ADMIN_EMAIL=admin@adoptimizer.dev
SECURITY__REQUIRE_ACTION_APPROVAL=true

# ---------- LLM ----------
# mock | openai | azure_openai | openai_compatible
LLM__PROVIDER=mock
LLM__MODEL=gpt-4o-mini
LLM__API_KEY=
LLM__MONTHLY_BUDGET_USD=200

# ---------- Data ----------
# mock: simulated ad platforms. warehouse: read ClickHouse (needs --profile analytics).
DATA_MODE=mock
CLICKHOUSE_DATABASE=ad_optimizer
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ---------- Optimization ----------
OPTIMIZATION__USE_CONVEX_SOLVER=true

# ---------- Scheduled metric ingestion ----------
# Consumed by the `ingest` profile service and by the backend itself.
# Leave the loop off: run one pass on a schedule instead.
#   docker compose --profile ingest run --rm ingest
INGEST__SCHEDULER_ENABLED=false
# synthetic | platform. Never schedule synthetic against real data.
INGEST__SOURCES=["synthetic"]
INGEST__INTERVAL_MINUTES=360
INGEST__LOOKBACK_DAYS=3
# Missed runs recover themselves up to this many days back; beyond it the tick
# reports gap_days and names the backfill command instead of narrowing quietly.
INGEST__MAX_CATCHUP_DAYS=14
INGEST__LEASE_TTL_SECONDS=1800
# Rehearse: plan and pull, report what would land, write nothing.
INGEST__DRY_RUN=false

# ---------- Observability ----------
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__JSON_LOGS=true

# ---------- Frontend build args (baked into the bundle at build time) ----------
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=Ad Optimizer