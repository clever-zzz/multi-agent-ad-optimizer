# syntax=docker/dockerfile:1
#
# Frontend image: builds the Vite bundle, serves it from nginx.
# Build context is the repository root:
#   docker build -f deploy/docker/Dockerfile.frontend \
#     --build-arg VITE_API_BASE_URL=/api/v1 -t adoptimizer-frontend .

ARG NODE_VERSION=22

# ---------- Stage 1: build ----------
FROM node:${NODE_VERSION}-alpine AS builder

WORKDIR /build

# Vite inlines VITE_* at build time, so the API origin is a build argument.
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_APP_TITLE="Ad Optimizer"
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_APP_TITLE=${VITE_APP_TITLE}

# Copy the manifests first so the dependency layer is cached across source edits.
COPY frontend/package.json frontend/pnpm-lock.yaml* frontend/package-lock.json* ./

RUN if [ -f pnpm-lock.yaml ]; then \
        corepack enable && pnpm install --frozen-lockfile; \
    elif [ -f package-lock.json ]; then \
        npm ci; \
    else \
        npm install; \
    fi

COPY frontend/ ./

RUN if [ -f pnpm-lock.yaml ]; then \
        corepack enable && pnpm run build; \
    else \
        npm run build; \
    fi

# ---------- Stage 2: serve ----------
FROM nginx:1.27-alpine AS runtime

# The entrypoint renders templates/*.template into conf.d/*.conf with envsubst,
# so the backend address stays a runtime setting instead of a build-time one.
COPY deploy/docker/nginx.conf /etc/nginx/nginx.conf
COPY deploy/docker/nginx-default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /build/dist /usr/share/nginx/html

ENV API_UPSTREAM=api:8000 \
    LISTEN_PORT=8080 \
    SSE_READ_TIMEOUT=3600s \
    NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx/conf.d

RUN chown -R nginx:nginx /usr/share/nginx/html \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --spider http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]