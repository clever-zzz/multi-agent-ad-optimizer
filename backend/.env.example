# ==========================================================
# Ad Optimizer backend configuration
#
# Every key maps to a field on adoptimizer.core.config.Settings.
# Nested groups use a double underscore: GROUP__FIELD.
# Copy this file to `.env` for local development. Never commit `.env`.
#
# Comments live on their own line: python-dotenv only strips trailing comments
# from unquoted values, and several values here are JSON.
#
# Settings are validated eagerly, so a misconfigured deployment refuses to boot
# instead of degrading silently. In staging/production the app additionally
# rejects demo-grade secrets, wildcard CORS and SQLite
# (see Settings._enforce_production_hardening).
# ==========================================================

# ---------- Application ----------
APP__NAME=Ad Optimizer
# Reported by /healthz, /system/info and the OpenAPI schema.
APP__VERSION=1.0.0
# development | test | staging | production
APP__ENVIRONMENT=development
APP__API_V1_PREFIX=/api/v1
APP__CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:4173"]
APP__CORS_ALLOW_CREDENTIALS=true
APP__TRUSTED_HOSTS=["*"]
APP__REQUEST_TIMEOUT_SECONDS=30
APP__MAX_REQUEST_BODY_BYTES=2097152

# ---------- Database ----------
# SQLite for local development, PostgreSQL everywhere else (mandatory in prod).
DATABASE__URL=sqlite+aiosqlite:///./adoptimizer.db
# DATABASE__URL=postgresql+asyncpg://adoptimizer:adoptimizer@localhost:5432/adoptimizer
DATABASE__ECHO=false
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_RECYCLE_SECONDS=1800
DATABASE__POOL_PRE_PING=true
# Kill runaway queries server-side. Leave unset for SQLite.
# DATABASE__STATEMENT_TIMEOUT_MS=15000

# ---------- Redis ----------
# Cache, rate limiting and the run-progress pub/sub bus. When disabled the app
# falls back to in-process equivalents, which are NOT shared across replicas.
REDIS__ENABLED=true
REDIS__URL=redis://localhost:6379/0
REDIS__CACHE_TTL_SECONDS=300
REDIS__MAX_CONNECTIONS=50
REDIS__SOCKET_TIMEOUT_SECONDS=5
# Separate budget for establishing the TCP connection, so an unreachable host
# fails fast instead of consuming the command timeout.
REDIS__SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS__KEY_PREFIX=adoptimizer

# ---------- ClickHouse ----------
# Analytical warehouse. Only consulted when DATA_MODE=warehouse.
CLICKHOUSE__ENABLED=false
CLICKHOUSE__HOST=localhost
CLICKHOUSE__HTTP_PORT=8123
CLICKHOUSE__NATIVE_PORT=9000
CLICKHOUSE__USER=default
CLICKHOUSE__PASSWORD=
CLICKHOUSE__DATABASE=ad_optimizer
CLICKHOUSE__SECURE=false
CLICKHOUSE__VERIFY_TLS=true
CLICKHOUSE__CONNECT_TIMEOUT_SECONDS=10
CLICKHOUSE__QUERY_TIMEOUT_SECONDS=30
# events | daily - which table the ClickHouse read model queries. "daily" reads
# campaign_daily_metrics, the aggregate that `adoptimizer warehouse sync` mirrors from
# the primary datastore's daily reports: the only source with a writer in this build.
# It carries no demographics by construction, so audience_observations degrades to the
# campaign split and says so. "events" reads the raw ad_events stream (device/country/
# gender, so audience breakdowns are real rather than a fallback), but nothing
# populates that table yet: reads come back empty and reports fall back to the primary
# datastore, so the backend logs clickhouse_events_source_has_no_writer when it is
# selected. Opt into it once an event pipeline writes ad_events.
CLICKHOUSE__METRICS_SOURCE=daily

# ---------- Security ----------
# Generate a real secret with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECURITY__JWT_SECRET=dev-only-insecure-secret-change-me-please-32chars
# HS256 | HS512 | RS256
SECURITY__JWT_ALGORITHM=HS256
SECURITY__ISSUER=adoptimizer
SECURITY__AUDIENCE=adoptimizer-api
SECURITY__ACCESS_TOKEN_TTL_MINUTES=30
SECURITY__REFRESH_TOKEN_TTL_DAYS=7

# Argon2id cost factors. Raise these as your CPU budget allows; the login path
# is the only place they are paid.
SECURITY__ARGON2_TIME_COST=3
SECURITY__ARGON2_MEMORY_COST_KIB=65536
SECURITY__ARGON2_PARALLELISM=2
SECURITY__PASSWORD_MIN_LENGTH=10
SECURITY__MAX_FAILED_LOGINS=5
SECURITY__LOCKOUT_SECONDS=900

# Bootstrap administrator, created by `adoptimizer seed` on an empty database.
# Change this before the first boot in any shared environment.
SECURITY__BOOTSTRAP_ADMIN_EMAIL=admin@adoptimizer.dev
SECURITY__BOOTSTRAP_ADMIN_PASSWORD=Adm1n!ChangeMe

# Require a human to approve agent-proposed actions before they are executed.
SECURITY__REQUIRE_ACTION_APPROVAL=true
# Re-check the session store on every request so logout, deactivation and role
# changes take effect immediately instead of at access-token expiry. Costs one
# Redis/DB lookup per request; turn off only for latency-critical read traffic.
SECURITY__VERIFY_SESSION_ON_REQUEST=true

# ---------- Rate limiting ----------
RATE_LIMIT__ENABLED=true
RATE_LIMIT__DEFAULT_REQUESTS_PER_MINUTE=300
RATE_LIMIT__BURST=60
RATE_LIMIT__WRITE_REQUESTS_PER_MINUTE=60
RATE_LIMIT__OPTIMIZE_RUNS_PER_HOUR=20

# ---------- LLM ----------
# mock | openai | azure_openai | openai_compatible
# "mock" is deterministic, offline and free - use it for tests and demos.
#
# TO USE A REAL MODEL: copy this file to .env (it is gitignored) and edit it
# there. Never commit or paste a key anywhere else. The provider is plain
# httpx - no vendor SDK to install.
#
#   OpenAI            LLM__PROVIDER=openai
#                     LLM__API_KEY=sk-...
#                     LLM__MODEL=gpt-4o-mini
#
#   Azure OpenAI      LLM__PROVIDER=azure_openai
#                     LLM__API_KEY=<azure key>
#                     LLM__API_BASE=https://<resource>.openai.azure.com
#                     LLM__API_VERSION=2024-10-21
#                     LLM__MODEL=<deployment name>
#
#   DeepSeek/Moonshot/Qwen or any OpenAI-shaped endpoint:
#                     LLM__PROVIDER=openai_compatible
#                     LLM__API_KEY=<vendor key>
#                     LLM__API_BASE=https://api.deepseek.com/v1
#                     LLM__MODEL=deepseek-chat
#
# Any provider other than mock REQUIRES a non-empty LLM__API_KEY or the app
# refuses to boot (see _require_key_for_hosted_providers in core/config.py).
LLM__PROVIDER=mock
LLM__MODEL=gpt-4o-mini
LLM__API_KEY=
LLM__API_BASE=
LLM__API_VERSION=
LLM__ORGANIZATION=
LLM__TEMPERATURE=0.4
LLM__MAX_TOKENS=1024
# Stream token deltas instead of waiting for the whole completion. Required by
# vendors that only answer their reasoning models in stream mode (Qwen3 thinking
# is the usual reason to switch it on), and it turns LLM__TIMEOUT_SECONDS into a
# per-chunk read timeout rather than a cap on the entire generation. A cache hit
# is still delivered, as one whole fragment. Off by default so a deployment keeps
# its current behaviour until a consumer renders increments.
LLM__STREAM=false
LLM__TIMEOUT_SECONDS=45
LLM__MAX_RETRIES=3
LLM__RETRY_BASE_DELAY_SECONDS=0.5
LLM__CONCURRENCY=4
LLM__CACHE_ENABLED=true
LLM__CACHE_TTL_SECONDS=3600
LLM__MONTHLY_BUDGET_USD=200
# Per-model price in USD per ONE MILLION tokens, as [prompt, completion], in a
# single JSON object. The built-in table (DEFAULT_PRICING in llm/base.py) covers
# the common OpenAI/DeepSeek/Qwen names at international list price; anything
# missing is costed from its "default" row, which the backend warns about at
# boot. Override it whenever your real bill differs, because this number is what
# LLM__MONTHLY_BUDGET_USD and GET /api/v1/analytics/llm-spend are computed from.
# Regional billing is the usual reason: dashscope.aliyuncs.com is the China
# region and bills in CNY, roughly a third of the international USD list price,
# so a qwen-plus deployment there should state its own numbers:
# LLM__PRICING={"qwen-plus": [0.113, 0.282]}
# Entries you do not list keep their built-in price, and "default" itself can be
# overridden. Prices are USD-only to match LLM__MONTHLY_BUDGET_USD; convert.
LLM__PRICING=
# Fall back to the deterministic mock instead of failing the run when the model
# provider errors or the monthly budget is exhausted. Set false to fail loudly.
LLM__FAIL_OPEN_TO_MOCK=true

# ---------- Optimization tunables ----------
OPTIMIZATION__MAX_ITERATIONS=3
OPTIMIZATION__DEFAULT_TARGET_ROAS=2.0
OPTIMIZATION__DEFAULT_TARGET_CPA=100
OPTIMIZATION__ALERT_CTR_FLOOR=0.005
OPTIMIZATION__ALERT_CPA_CEILING=200
OPTIMIZATION__ALERT_ROAS_FLOOR=1.0
OPTIMIZATION__MIN_IMPRESSIONS_FOR_ALERTS=100
# Burn-rate detection. A campaign alerts once daily spend / daily budget
# exceeds BURN_RATE_MULTIPLIER, and escalates to critical above
# BURN_RATE_CRITICAL_MULTIPLIER. The critical line is a deployment decision
# (how far over budget counts as an emergency), so it is named rather than
# hard-coded as multiplier * 1.5. HYSTERESIS is the fraction below the
# critical line a campaign must fall back to before it is downgraded again,
# which stops a ratio hovering at the boundary from flipping every run.
OPTIMIZATION__BURN_RATE_MULTIPLIER=1.25
OPTIMIZATION__BURN_RATE_CRITICAL_MULTIPLIER=1.875
OPTIMIZATION__BURN_RATE_HYSTERESIS=0.05
OPTIMIZATION__CREATIVE_SCORE_THRESHOLD=40
OPTIMIZATION__MAX_BUDGET_CHANGE_PCT=50
OPTIMIZATION__BID_CAP_RATIO_OF_TARGET_CPA=0.8
OPTIMIZATION__MAX_CAMPAIGNS_PER_RUN=200
# Requires the `analytics` extra (cvxpy). Falls back to the greedy allocator
# when the solver is unavailable or fails to converge.
OPTIMIZATION__USE_CONVEX_SOLVER=true

# ---------- Data mode ----------
# Where campaign telemetry comes from. This gates the ad-platform adapters, NOT
# the analytical read backend:
#   mock       route every platform call to the mock adapter; real credentials
#              are read but never used, and the `platform` ingest source refuses
#   warehouse  use the real adapters and unlock the `platform` ingest source
# Reading ClickHouse is a separate switch, and turning the warehouse on is three
# switches that have to agree:
#   DATA_MODE=warehouse              use the real platform adapters
#   CLICKHOUSE__ENABLED=true         analytical reads go to ClickHouse, not the
#                                    SQL reader
#   CLICKHOUSE__METRICS_SOURCE=daily and they read the table `warehouse sync`
#                                    actually writes
# Setting DATA_MODE=warehouse on its own still serves analytical reads from
# SQLite/PostgreSQL via SqlAggregateWarehouse, and does so silently - so set all
# three. See docs/tutorial/04-clickhouse-guide.md.
DATA_MODE=mock

# ---------- Observability ----------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__JSON_LOGS=true
OBSERVABILITY__LOG_REQUEST_BODY=false
OBSERVABILITY__METRICS_ENABLED=true
OBSERVABILITY__TRACING_ENABLED=false
OBSERVABILITY__OTLP_ENDPOINT=
OBSERVABILITY__SERVICE_NAME=adoptimizer-backend

# ---------- Tool layer ----------
# The boundary where code touches a live ad account. Every capability an agent
# may use is a named tool; the executor validates, authorises, budgets, audits
# and dry-runs them in one place.
TOOLS__ENABLED=true
# Paper-trading switch. true = even a human-approved execution is recorded but
# never sent to the platform. Turn it off only once you trust the account.
TOOLS__DRY_RUN=false
# Agents may READ anything they are granted, but a mutation an agent asks for is
# always a dry-run preflight unless this is true. Leave it false: real spend
# should follow a human approval, not a model's confidence score.
TOOLS__ALLOW_AGENT_WRITES=false
TOOLS__MAX_CALLS_PER_RUN=500
TOOLS__AUDIT_PERSIST=true

# ---------- Scheduled ingestion ----------
# How `daily_metrics` stays current without anyone pressing a button:
#   adoptimizer scheduler --once     # one pass; this is what a CronJob calls
#   adoptimizer scheduler            # resident loop, INGEST__INTERVAL_MINUTES
# The window is derived from the calendar, never from a stored cursor, so a
# missed run is closed by the next one rather than lost. The watermark is read
# only to prove a run would be redundant, and written for observability.
INGEST__SCHEDULER_ENABLED=false
# Feeds to pull, JSON array. "synthetic" generates numbers and belongs in demos
# only - never schedule it against production data. "platform" reads the ad
# platform clients, so it needs the credentials below plus DATA_MODE=warehouse.
INGEST__SOURCES=["synthetic"]
INGEST__INTERVAL_MINUTES=360
# Overlap that absorbs platforms revising yesterday for days afterwards. Costs
# one query, cannot corrupt a value: ingestion upserts one slot per (campaign,
# creative, date) and an absent column never overwrites a stored number.
INGEST__LOOKBACK_DAYS=3
# How far back a missed run may reach on its own. Beyond it the tick reports
# gap_days and names `adoptimizer ingest --start ... --end ...` instead of
# quietly narrowing the window. Must be >= INGEST__LOOKBACK_DAYS.
INGEST__MAX_CATCHUP_DAYS=14
# Single-flight guard lifetime. Must exceed one pass or a slow pull is stolen
# mid-flight by the next one. Expired leases are reclaimable, not lost.
INGEST__LEASE_TTL_SECONDS=1800
# Rehearse: plan, pull, report what would land, write nothing and never advance
# the watermark. `--dry-run` on the CLI can only add rehearsal, never remove it.
INGEST__DRY_RUN=false

# ---------- Ad platform credentials (only needed when DATA_MODE=warehouse) ----------
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
