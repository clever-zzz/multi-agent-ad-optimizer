# ==========================================================
# Ad Optimizer backend configuration
#
# Every key maps to a field on adoptimizer.core.config.Settings.
# Nested groups use a double underscore: GROUP__FIELD.
# Copy this file to `.env` for local development. Never commit `.env`.
#
# Comments live on their own line: python-dotenv only strips trailing comments
# from unquoted values, and several values here are JSON.
#
# Settings are validated eagerly, so a misconfigured deployment refuses to boot
# instead of degrading silently. In staging/production the app additionally
# rejects demo-grade secrets, wildcard CORS and SQLite
# (see Settings._enforce_production_hardening).
# ==========================================================

# ---------- Application ----------
APP__NAME=Ad Optimizer
# development | test | staging | production
APP__ENVIRONMENT=development
APP__API_V1_PREFIX=/api/v1
APP__CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:4173"]
APP__CORS_ALLOW_CREDENTIALS=true
APP__TRUSTED_HOSTS=["*"]
APP__REQUEST_TIMEOUT_SECONDS=30
APP__MAX_REQUEST_BODY_BYTES=2097152

# ---------- Database ----------
# SQLite for local development, PostgreSQL everywhere else (mandatory in prod).
DATABASE__URL=sqlite+aiosqlite:///./adoptimizer.db
# DATABASE__URL=postgresql+asyncpg://adoptimizer:adoptimizer@localhost:5432/adoptimizer
DATABASE__ECHO=false
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_RECYCLE_SECONDS=1800
DATABASE__POOL_PRE_PING=true
# Kill runaway queries server-side. Leave unset for SQLite.
# DATABASE__STATEMENT_TIMEOUT_MS=15000

# ---------- Redis ----------
# Cache, rate limiting and the run-progress pub/sub bus. When disabled the app
# falls back to in-process equivalents, which are NOT shared across replicas.
REDIS__ENABLED=true
REDIS__URL=redis://localhost:6379/0
REDIS__CACHE_TTL_SECONDS=300
REDIS__MAX_CONNECTIONS=50
REDIS__SOCKET_TIMEOUT_SECONDS=5
REDIS__KEY_PREFIX=adoptimizer

# ---------- ClickHouse ----------
# Analytical warehouse. Only consulted when DATA_MODE=warehouse.
CLICKHOUSE__ENABLED=false
CLICKHOUSE__HOST=localhost
CLICKHOUSE__HTTP_PORT=8123
CLICKHOUSE__NATIVE_PORT=9000
CLICKHOUSE__USER=default
CLICKHOUSE__PASSWORD=
CLICKHOUSE__DATABASE=ad_optimizer
CLICKHOUSE__SECURE=false
CLICKHOUSE__VERIFY_TLS=true
CLICKHOUSE__CONNECT_TIMEOUT_SECONDS=10
CLICKHOUSE__QUERY_TIMEOUT_SECONDS=30

# ---------- Security ----------
# Generate a real secret with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECURITY__JWT_SECRET=dev-only-insecure-secret-change-me-please-32chars
# HS256 | HS512 | RS256
SECURITY__JWT_ALGORITHM=HS256
SECURITY__ISSUER=adoptimizer
SECURITY__AUDIENCE=adoptimizer-api
SECURITY__ACCESS_TOKEN_TTL_MINUTES=30
SECURITY__REFRESH_TOKEN_TTL_DAYS=7

# Argon2id cost factors. Raise these as your CPU budget allows; the login path
# is the only place they are paid.
SECURITY__ARGON2_TIME_COST=3
SECURITY__ARGON2_MEMORY_COST_KIB=65536
SECURITY__ARGON2_PARALLELISM=2
SECURITY__PASSWORD_MIN_LENGTH=10
SECURITY__MAX_FAILED_LOGINS=5
SECURITY__LOCKOUT_SECONDS=900

# Bootstrap administrator, created by `adoptimizer seed` on an empty database.
# Change this before the first boot in any shared environment.
SECURITY__BOOTSTRAP_ADMIN_EMAIL=admin@adoptimizer.dev
SECURITY__BOOTSTRAP_ADMIN_PASSWORD=Adm1n!ChangeMe

# Require a human to approve agent-proposed actions before they are executed.
SECURITY__REQUIRE_ACTION_APPROVAL=true
# Re-check the session store on every request so logout, deactivation and role
# changes take effect immediately instead of at access-token expiry. Costs one
# Redis/DB lookup per request; turn off only for latency-critical read traffic.
SECURITY__VERIFY_SESSION_ON_REQUEST=true

# ---------- Rate limiting ----------
RATE_LIMIT__ENABLED=true
RATE_LIMIT__DEFAULT_REQUESTS_PER_MINUTE=300
RATE_LIMIT__BURST=60
RATE_LIMIT__WRITE_REQUESTS_PER_MINUTE=60
RATE_LIMIT__OPTIMIZE_RUNS_PER_HOUR=20

# ---------- LLM ----------
# mock | openai | azure_openai | openai_compatible
# "mock" is deterministic, offline and free - use it for tests and demos.
LLM__PROVIDER=mock
LLM__MODEL=gpt-4o-mini
LLM__API_KEY=
LLM__API_BASE=
LLM__API_VERSION=
LLM__ORGANIZATION=
LLM__TEMPERATURE=0.4
LLM__MAX_TOKENS=1024
LLM__TIMEOUT_SECONDS=45
LLM__MAX_RETRIES=3
LLM__RETRY_BASE_DELAY_SECONDS=0.5
LLM__CONCURRENCY=4
LLM__CACHE_ENABLED=true
LLM__CACHE_TTL_SECONDS=3600
LLM__MONTHLY_BUDGET_USD=200
# Fall back to the deterministic mock instead of failing the run when the model
# provider errors or the monthly budget is exhausted. Set false to fail loudly.
LLM__FAIL_OPEN_TO_MOCK=true

# ---------- Optimization tunables ----------
OPTIMIZATION__MAX_ITERATIONS=3
OPTIMIZATION__DEFAULT_TARGET_ROAS=2.0
OPTIMIZATION__DEFAULT_TARGET_CPA=100
OPTIMIZATION__ALERT_CTR_FLOOR=0.005
OPTIMIZATION__ALERT_CPA_CEILING=200
OPTIMIZATION__ALERT_ROAS_FLOOR=1.0
OPTIMIZATION__MIN_IMPRESSIONS_FOR_ALERTS=100
OPTIMIZATION__CREATIVE_SCORE_THRESHOLD=40
OPTIMIZATION__MAX_BUDGET_CHANGE_PCT=50
OPTIMIZATION__BID_CAP_RATIO_OF_TARGET_CPA=0.8
OPTIMIZATION__MAX_CAMPAIGNS_PER_RUN=200
# Requires the `analytics` extra (cvxpy). Falls back to the greedy allocator
# when the solver is unavailable or fails to converge.
OPTIMIZATION__USE_CONVEX_SOLVER=true

# ---------- Data mode ----------
# mock: adapters simulate the ad platforms. warehouse: read ClickHouse.
DATA_MODE=mock

# ---------- Observability ----------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__JSON_LOGS=true
OBSERVABILITY__LOG_REQUEST_BODY=false
OBSERVABILITY__METRICS_ENABLED=true
OBSERVABILITY__TRACING_ENABLED=false
OBSERVABILITY__OTLP_ENDPOINT=
OBSERVABILITY__SERVICE_NAME=adoptimizer-backend

# ---------- Ad platform credentials (only needed when DATA_MODE=warehouse) ----------
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=